# Provider selection: ollama or vps
OCR_PROVIDER=ollama

# Provider endpoints
OLLAMA_OCR_ENDPOINT=http://localhost:11434/api/ocr
VPS_OCR_ENDPOINT=http://YOUR_VPS_IP:8001/ocr

# HTTP timeout in seconds for upstream OCR calls
OCR_HTTP_TIMEOUT=30

# Comma-separated allowed origins for browser clients
CORS_ALLOW_ORIGINS=*
