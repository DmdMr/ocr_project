{
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^38.5.0",
    "electron-builder": "^26.0.12",
    "wait-on": "^9.0.3"
  },
  "name": "ocr_project",
  "version": "1.0.0",
  "description": "Веб-приложение для распознавания рукописного текста с изображений, анализа и хранения данных.",
  "main": "electron/main.js",
  "dependencies": {
    "ansi-regex": "^5.0.1",
    "ansi-styles": "^4.3.0",
    "chalk": "^4.1.2",
    "cliui": "^8.0.1",
    "color-convert": "^2.0.1",
    "color-name": "^1.1.4",
    "emoji-regex": "^8.0.0",
    "escalade": "^3.2.0",
    "get-caller-file": "^2.0.5",
    "has-flag": "^4.0.0",
    "is-fullwidth-code-point": "^3.0.0",
    "require-directory": "^2.1.1",
    "rxjs": "^7.8.2",
    "shell-quote": "^1.8.3",
    "string-width": "^4.2.3",
    "strip-ansi": "^6.0.1",
    "supports-color": "^8.1.1",
    "tree-kill": "^1.2.2",
    "tslib": "^2.8.1",
    "wrap-ansi": "^7.0.0",
    "y18n": "^5.0.8",
    "yargs": "^17.7.2",
    "yargs-parser": "^21.1.1"
  },
  "scripts": {
    "frontend": "cd frontend && npm run dev -- --host 0.0.0.0",
    "backend:mac": "./venv/bin/python -m uvicorn backend.app.main:app --reload --host 0.0.0.0 --port 8000",
    "backend:win": "venv\\Scripts\\python.exe -m uvicorn backend.app.main:app --reload --host 0.0.0.0 --port 8000",
    "dev:mac": "concurrently -n FRONTEND,BACKEND -c blue,green \"npm run frontend\" \"npm run backend:mac\"",
    "dev:win": "concurrently -n FRONTEND,BACKEND -c blue,green \"npm run frontend\" \"npm run backend:win\"",
    "frontend:build": "cd frontend && npm run build",
    "electron": "cross-env ELECTRON_START_BACKEND=true electron .",
    "electron:build": "npm run frontend:build && npm run backend:build && electron-builder",
    "electron:build:mac": "npm run frontend:build && npm run backend:build && electron-builder --mac dmg zip",
    "electron:build:win": "npm run frontend:build && npm run backend:build && electron-builder --win nsis --x64",
    "electron:build:linux": "npm run frontend:build && electron-builder --linux deb AppImage",
    "electron:dev": "npm run frontend:build && cross-env ELECTRON_START_BACKEND=true electron .",
    "backend:dev": "python3 -m backend.desktop_server",
    "backend:build": "pyinstaller --clean --noconfirm backend/ocr_backend.spec",
    "dist:mac": "npm run electron:build:mac",
    "dist:win": "npm run electron:build:win",
    "electron:build:mac:x64": "npm run frontend:build && npm run backend:build && electron-builder --mac dmg zip --x64",
    "electron:build:mac:arm64": "npm run frontend:build && npm run backend:build && electron-builder --mac dmg zip --arm64",
    "dist:mac:x64": "npm run electron:build:mac:x64",
    "dist:mac:arm64": "npm run electron:build:mac:arm64"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DmdMr/ocr_project.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/DmdMr/ocr_project/issues"
  },
  "homepage": "https://github.com/DmdMr/ocr_project#readme",
  "build": {
    "appId": "com.ocrproject.desktop",
    "productName": "OCR Project",
    "asar": true,
    "asarUnpack": [
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "backend-dist",
        "filter": [
          "ocr-backend",
          "ocr-backend.exe"
        ]
      },
      {
        "from": "frontend/dist",
        "to": "frontend/dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "sign": false,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "extraMetadata": {
      "main": "electron/main.js"
    }
  }
}
